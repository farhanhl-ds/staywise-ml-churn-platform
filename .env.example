# ─── App ───────────────────────────────────────────────
APP_NAME=StayWise
APP_ENV=development        # development | production
DEBUG=false

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://staywise:password@localhost:5432/staywise_db

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Kafka ─────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=ecommerce.transactions
KAFKA_TOPIC_EVENTS=ecommerce.events

# ─── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_CHURN_MODEL_URI=models:/ChurnPredictor/Production
MLFLOW_SENTIMENT_MODEL_URI=models:/SentimentAnalyzer/Production

# ─── AWS S3 ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=staywise-model-artifacts

# ─── Ollama (AI Analyst) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]
